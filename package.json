{
  "name": "bgrowth-homepage",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:api && tsc && vite build",
    "preview": "vite preview",
    "check:api": "grep -rqE \"from ['\\\"]\\\\.\\\\./src\" api/ && echo 'ERRO: um arquivo em api/ importa de src/. A Vercel nao envia src/ junto com a funcao, entao ela quebra em producao no carregamento do modulo (ERR_MODULE_NOT_FOUND) — e o tsc nao pega isso. Copie o que precisa para dentro de api/.' && exit 1 || exit 0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.3",
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-image": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "framer-motion": "^11.0.0",
    "html2pdf.js": "^0.14.0",
    "lucide-react": "^0.383.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.23.0",
    "stripe": "^22.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vercel/node": "^5.8.24",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.31",
