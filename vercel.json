{
  "redirects": [
    {
      "source": "/ingles-de-mudanca",
      "destination": "/p/bruno/ingles-de-mudanca",
      "permanent": false
    },
    {
      "source": "/ingles-de-mudanca/:path*",
      "destination": "/p/bruno/ingles-de-mudanca/:path*",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/p/bruno/ingles-de-mudanca/:path*",
      "destination": "https://ingles-de-mudanca-bg-rowrh-club.vercel.app/p/bruno/ingles-de-mudanca/:path*"
    },
    {
      "source": "/:path((?!api/|assets/).*)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|meta-externalagent|WhatsApp|Twitterbot|LinkedInBot|Slackbot|TelegramBot|Discordbot|Pinterest|redditbot|SkypeUriPreview|Iframely|Embedly|vkShare|Snapchat|bitlybot|Tumblr).*"
        }
      ],
      "destination": "/api/ingles?action=og&path=:path"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/confirmation-reminders",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/review-requests",
      "schedule": "0 15 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'; object-src 'none'; base-uri 'self'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        }
      ]
    }
  ]
}
